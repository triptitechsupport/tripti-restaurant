# Enter these in Render Environment. Never commit a filled-in copy.
NODE_ENV=production
FISKALY_ENVIRONMENT=TEST
FISKALY_ENABLED=false
FISKALY_LIVE_CONFIRMED=false
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
PB_ENCRYPTION_KEY=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_WAITER_PASSWORD=
DEMO_KDS_PASSWORD=
# CORS_ORIGIN defaults to Render's RENDER_EXTERNAL_URL. Set it for a custom domain.
# Optional TEST fiscal configuration; enable FISKALY_ENABLED after entering it.
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_CASH_REGISTER_ID=
FISKALY_SCU_ID=
FISKALY_VAT_ID=ATU12345678
FISCAL_COMPANY_NAME=Tripti Genusswelt DEVELOPMENT TEST
FISCAL_COMPANY_ADDRESS=Musterstrasse 1, 1010 Wien TEST
# Optional: STRIPE_SECRET_KEY (leave absent if Stripe is unused).
