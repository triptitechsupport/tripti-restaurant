PORT=3001
CORS_ORIGIN=*
STRIPE_SECRET_KEY=sk_test_placeholder
ECOMMERCE_API_BASE=https://api.example.com

# ---- Fiskaly SIGN AT (RKSV) — TEST environment only ----
# Server-side only. NEVER expose these to the browser.
# Replace the YOUR_TEST_* placeholder values with your real Fiskaly TEST
# credentials (dashboard.fiskaly.com) and FinanzOnline RKSV web-service user
# credentials before running setup.
FISKALY_ENVIRONMENT=test
FISKALY_API_KEY=YOUR_TEST_API_KEY
FISKALY_API_SECRET=YOUR_TEST_API_SECRET
FON_PARTICIPANT_ID=YOUR_TEST_FON_PARTICIPANT_ID
FON_USER_ID=YOUR_TEST_FON_USER_ID
FON_USER_PIN=YOUR_TEST_FON_USER_PIN
FISKALY_VAT_ID=YOUR_TEST_VAT_ID
FISKALY_LEGAL_ENTITY_NAME=Tripti Genusswelt
FISKALY_DEFAULT_PAYMENT_TYPE=CASH